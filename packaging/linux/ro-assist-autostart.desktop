[Desktop Entry]
Type=Application
Version=1.0
Name=ro-Assist Welcome
Comment=Launch the Ro-ASD first-run and maintenance center on the first KDE login
Exec=env QT_QPA_PLATFORM=xcb QT_XCB_GL_INTEGRATION=xcb_glx ro-assist --autostart
Icon=ro-assist
Terminal=false
OnlyShowIn=KDE;
NoDisplay=true
StartupNotify=false
X-KDE-autostart-after=panel
